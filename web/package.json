{
	"name": "web",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"packageManager": "pnpm@10.33.0",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"build:docker": "vite build",
		"typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
		"lint": "eslint --cache --cache-location node_modules/.cache/eslint/ --cache-strategy content --no-warn-ignored ${@:-.}",
		"format": "biome check . ../web-shared",
		"format:fix": "biome check --write",
		"preview": "vite preview",
		"test": "NODE_OPTIONS='--disable-warning=ExperimentalWarning --disable-warning=DEP0205' vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource-variable/onest": "^5.3.0",
		"@fontsource-variable/schibsted-grotesk": "^5.3.0",
		"@phosphor-icons/react": "^2.1.10",
		"@shikijs/langs": "^4.4.3",
		"@shikijs/themes": "^4.4.3",
		"@simplewebauthn/browser": "^13.3.0",
		"@tanstack/react-query": "^5.101.4",
		"@tanstack/react-virtual": "^3.14.9",
		"i18next": "^26.3.6",
		"i18next-browser-languagedetector": "^8.2.1",
		"immer": "^11.1.16",
		"katex": "^0.18.4",
		"qrcode": "^1.5.4",
		"react": "^19.2.8",
		"react-colorful": "5.8.0",
		"react-dom": "^19.2.8",
		"react-i18next": "^17.0.11",
		"react-markdown": "^10.1.0",
		"react-router": "^8.3.0",
		"recharts": "^3.10.1",
		"rehype-katex": "^7.0.1",
		"remark-gfm": "^4.0.1",
		"remark-math": "^6.0.0",
		"shiki": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.8",
		"@eslint/js": "^10.0.1",
		"@tailwindcss/postcss": "^4.3.3",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.4",
		"@types/node": "^26.2.0",
		"@types/qrcode": "^1.5.6",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@typescript/native": "npm:typescript@~7.0.2",
		"@vitejs/plugin-react": "^6.0.5",
		"@vitest/coverage-v8": "^4.1.10",
		"autoprefixer": "^10.5.4",
		"eslint": "^10.8.1",
		"eslint-plugin-react-hooks": "^7.0.1",
		"eslint-plugin-react-refresh": "^0.5.4",
		"globals": "^17.11.0",
		"jsdom": "^30.0.1",
		"msw": "^2.15.0",
		"postcss": "^8.5.26",
		"tailwindcss": "^4.3.3",
		"typescript": "npm:@typescript/typescript6@~6.0.2",
		"typescript-eslint": "^8.67.0",
		"vite": "^8.2.1",
		"vitest": "^4.1.10"
	},
	"msw": {
		"workerDirectory": [
			"public"
		]
	}
}
