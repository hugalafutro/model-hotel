{
	"name": "web",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"packageManager": "pnpm@12.11.2",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"build:docker": "vite build",
		"typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
		"lint": "eslint --cache --cache-location node_modules/.cache/eslint/ --cache-strategy content --no-warn-ignored ${@:-.} && pnpm lint:shared",
		"lint:shared": "cd ../web-shared && ../web/node_modules/.bin/eslint --no-warn-ignored .",
		"format": "biome check . && pnpm format:shared",
		"format:shared": "cd ../web-shared && ../web/node_modules/.bin/biome check .",
		"format:shared:fix": "cd ../web-shared && ../web/node_modules/.bin/biome check --write .",
		"format:fix": "biome check --write",
		"preview": "vite preview",
		"test": "NODE_OPTIONS='--disable-warning=ExperimentalWarning --disable-warning=DEP0205' vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource-variable/onest": "^5.3.1",
		"@fontsource-variable/schibsted-grotesk": "^5.3.0",
		"@phosphor-icons/react": "^2.1.10",
		"@shikijs/langs": "^4.6.0",
		"@shikijs/themes": "^4.6.0",
		"@simplewebauthn/browser": "^14.0.0",
		"@tanstack/react-query": "^5.107.1",
		"@tanstack/react-virtual": "^3.14.26",
		"i18next": "^26.7.2",
		"i18next-browser-languagedetector": "^8.3.0",
		"immer": "^11.2.9",
		"katex": "^0.19.1",
		"qrcode": "^1.5.4",
		"react": "^19.3.1",
		"react-colorful": "^5.8.1",
		"react-dom": "^19.3.1",
		"react-i18next": "^17.1.13",
		"react-markdown": "^10.1.0",
		"react-router": "^8.5.1",
		"recharts": "^3.10.1",
		"rehype-katex": "^7.0.1",
		"remark-gfm": "^4.0.1",
		"remark-math": "^6.0.0",
		"shiki": "^4.6.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.6",
		"@eslint/js": "^10.0.1",
		"@tailwindcss/postcss": "^4.3.5",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.8",
		"@types/node": "^26.6.6",
		"@types/qrcode": "^1.5.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@typescript/native": "npm:typescript@~7.0.2",
		"@vitejs/plugin-react": "^6.2.1",
		"@vitest/coverage-v8": "^5.1.0",
		"autoprefixer": "^10.6.2",
		"eslint": "^10.14.0",
		"eslint-plugin-react-hooks": "^7.0.1",
		"eslint-plugin-react-refresh": "^0.5.7",
		"globals": "^17.14.0",
		"jsdom": "^31.0.0",
		"msw": "^3.0.4",
		"postcss": "^8.5.32",
		"tailwindcss": "^4.3.5",
		"typescript": "npm:@typescript/typescript6@~6.0.2",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.6",
		"vitest": "^5.1.0"
	},
	"msw": {
		"workerDirectory": [
			"public"
		]
	}
}
