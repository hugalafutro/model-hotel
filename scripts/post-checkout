#!/usr/bin/env bash
# post-checkout: bring the tokensave index up to date with the checked-out branch
#   $3 == 1 (branch checkout) -> tokensave branch add --if-enabled, then sync
#   $3 == 0 (file checkout)   -> nothing
# branch add alone is not enough: for an already-tracked branch it is a no-op,
# and for a new branch reference-transaction runs it before the working tree
# switches, so the copied DB is never synced against this branch's files.
# Runs in the background so the checkout itself is not slowed down.
set -uo pipefail

[ "${3:-0}" = "1" ] || exit 0
command -v tokensave >/dev/null 2>&1 || exit 0

(
	tokensave branch add --if-enabled >/dev/null 2>&1
	tokensave sync >/dev/null 2>&1
) &

# The sync above runs silenced, which would hide tokensave's own update notice,
# so repeat it from the latest version tokensave caches (no network call here).
state="$HOME/.tokensave/state.toml"
[ -r "$state" ] || exit 0
latest="$(sed -n 's/^cached_latest_version = "\(.*\)"$/\1/p' "$state")"
current="$(tokensave --version 2>/dev/null | awk '{print $NF}')"
current="${current#v}"
if [ -n "$latest" ] && [ -n "$current" ] && [ "$latest" != "$current" ] &&
	[ "$(printf '%s\n%s\n' "$current" "$latest" | sort -V | tail -n1)" = "$latest" ]; then
	echo "tokensave $latest is available (installed: $current). Run \`tokensave upgrade\` to update." >&2
fi
