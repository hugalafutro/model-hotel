#!/usr/bin/env bash
# go-test-sharded - run `go test` for one or more packages, splitting the slow
# ones across several concurrent processes.
#
# `go test` already runs different PACKAGES in parallel, which is why the tree
# finishes in about the time its longest package takes. internal/api is that
# package: one test binary, ~1600 tests, all sequential against one Postgres
# database, minutes of wall clock that neither the pre-push hook nor CI can
# overlap with anything.
#
# Within a package the usual fix is t.Parallel(), which is not available here:
# the tests share one package-global pool and several TRUNCATE tables out from
# under each other, so marking them parallel would trade minutes for flakes.
# This shards at the PROCESS level instead. Each shard is an ordinary `go test`
# run over a disjoint subset of the package's top-level tests, with its own
# TEST_DB_SHARD and therefore its own database (see internal/db/testdb.go), so
# every sequential-within-a-process assumption the tests already make still
# holds. No test file changes, and no new way for a test to be flaky.
#
# Usage:
#   scripts/go-test-sharded [options] PKG...
#
#   --shards N          shards for a package that qualifies (default: auto)
#   --min-tests N       only shard packages with more than N tests (default 200)
#   --jobs N            concurrent `go test` processes (default: shards)
#   --coverprofile FILE merged coverage profile across every shard
#   --covermode MODE    passed to go test (default atomic when profiling)
#   --timeout D         passed to go test (default 10m)
#   --                  end of options
#
# Exits non-zero if any shard fails, after printing that shard's output.
#
# Each shard leaves its database behind, as every package's TestMain already does
# (SetupTestDB DROP+CREATEs on the next run, and TestMain's os.Exit skips the
# deferred cleanup). Steady state is one ~9MB database per package per shard.
# Lowering --shards orphans the higher-numbered ones; `make test-db-down
# test-db-up` clears the lot, and the server holds no data worth keeping.
set -uo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

SHARDS=""
MIN_TESTS=200
JOBS=""
COVERPROFILE=""
COVERMODE=""
TIMEOUT="10m"
PKGS=()

# --run-job is how the process pool re-enters this script: xargs runs one child
# per job file rather than the script trying to manage backgrounded PIDs itself.
if [ "${1:-}" = "--list-one" ]; then
	_pkg="$(cat "$2")"
	(cd "$REPO_ROOT" && go test -list '^Test' "$_pkg" 2>/dev/null) |
		grep -E '^Test' >"$2.tests"
	exit 0
fi

if [ "${1:-}" = "--run-job" ]; then
	JOB_FILE="$2"
	# shellcheck disable=SC1090 # generated by this script, one job's parameters
	source "$JOB_FILE"
	ARGS=(test -count=1 -timeout "$JOB_TIMEOUT")
	[ -n "$JOB_RUN" ] && ARGS+=(-run "$JOB_RUN")
	if [ -n "$JOB_COVER" ]; then
		ARGS+=(-coverprofile "$JOB_COVER" -covermode "$JOB_COVERMODE")
	fi
	ARGS+=("$JOB_PKG")
	_started=$SECONDS
	TEST_DB_SHARD="$JOB_SHARD" go "${ARGS[@]}" >"$JOB_LOG" 2>&1
	_code=$?
	echo "$((SECONDS - _started))" >"$JOB_SECS"
	echo "$_code" >"$JOB_STATUS"
	# Always 0: a failing shard is reported by its status file, and a non-zero
	# exit here would make xargs abandon the remaining jobs, so a single failure
	# would hide every other package's result.
	exit 0
fi

while [ $# -gt 0 ]; do
	case "$1" in
	--shards) SHARDS="$2"; shift 2 ;;
	--min-tests) MIN_TESTS="$2"; shift 2 ;;
	--jobs) JOBS="$2"; shift 2 ;;
	--coverprofile) COVERPROFILE="$2"; shift 2 ;;
	--covermode) COVERMODE="$2"; shift 2 ;;
	--timeout) TIMEOUT="$2"; shift 2 ;;
	--) shift; PKGS+=("$@"); break ;;
	-*) echo "go-test-sharded: unknown option $1" >&2; exit 2 ;;
	*) PKGS+=("$1"); shift ;;
	esac
done

if [ ${#PKGS[@]} -eq 0 ]; then
	echo "go-test-sharded: no packages given" >&2
	exit 2
fi
[ -n "$COVERPROFILE" ] && [ -z "$COVERMODE" ] && COVERMODE="atomic"

# Shard count. These processes spend their time waiting on Postgres, not on CPU,
# so the useful count runs past the core count before it stops paying: measured
# on internal/api (12 cores), 1 shard 100s, 4 shards 40s, 6 shards 36s, 8 shards
# 33s. Capped at 6 because the curve is flat past it while the CPU cost keeps
# climbing, and because a full-tree run has other packages to fit alongside.
CORES="$( (nproc 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null || echo 4) )"
if [ -z "$SHARDS" ]; then
	SHARDS=$((CORES / 2))
	[ "$SHARDS" -lt 2 ] && SHARDS=2
	[ "$SHARDS" -gt 6 ] && SHARDS=6
fi
if [ -z "$JOBS" ]; then
	JOBS="$CORES"
	[ "$JOBS" -gt 8 ] && JOBS=8
	[ "$JOBS" -lt "$SHARDS" ] && JOBS="$SHARDS"
fi

WORK="$(mktemp -d)"
trap 'rm -rf "$WORK"' EXIT
mkdir -p "$WORK/jobs" "$WORK/cov" "$WORK/log" "$WORK/status" "$WORK/secs"

# Expand the package patterns once. `go test ./internal/...` would otherwise be
# opaque to the per-package listing below.
mapfile -t RESOLVED < <(cd "$REPO_ROOT" && go list "${PKGS[@]}")
if [ ${#RESOLVED[@]} -eq 0 ]; then
	echo "go-test-sharded: no packages matched" >&2
	exit 2
fi

job_n=0
add_job() { # add_job PKG SHARD_LABEL RUN_REGEX
	job_n=$((job_n + 1))
	local id
	id="$(printf '%04d' "$job_n")"
	{
		printf 'JOB_PKG=%q\n' "$1"
		printf 'JOB_SHARD=%q\n' "$2"
		printf 'JOB_RUN=%q\n' "$3"
		printf 'JOB_TIMEOUT=%q\n' "$TIMEOUT"
		printf 'JOB_COVERMODE=%q\n' "$COVERMODE"
		printf 'JOB_LOG=%q\n' "$WORK/log/$id"
		printf 'JOB_STATUS=%q\n' "$WORK/status/$id"
		printf 'JOB_SECS=%q\n' "$WORK/secs/$id"
		printf 'JOB_LABEL=%q\n' "$1${2:+ [$2]}"
		if [ -n "$COVERPROFILE" ]; then
			printf 'JOB_COVER=%q\n' "$WORK/cov/$id"
		else
			printf 'JOB_COVER=%q\n' ""
		fi
	} >"$WORK/jobs/$id"
}

# Listing runs each package's test binary, so doing it one package at a time
# costs about as much as a small test run. Same pool as the tests themselves.
mkdir -p "$WORK/list"
list_n=0
for pkg in "${RESOLVED[@]}"; do
	list_n=$((list_n + 1))
	printf '%s\n' "$pkg" >"$WORK/list/$(printf '%04d' "$list_n").pkg"
done
find "$WORK/list" -name '*.pkg' -print0 |
	xargs -0 -P "$JOBS" -I{} "${BASH_SOURCE[0]}" --list-one {}

for lf in "$WORK"/list/*.pkg; do
	pkg="$(cat "$lf")"
	# A package whose TestMain cannot reach its database produces no listing, and
	# falls back to one unsharded job that then reports the real error in the
	# normal place rather than being swallowed here.
	if [ -s "$lf.tests" ]; then
		mapfile -t TESTS <"$lf.tests"
	else
		TESTS=()
	fi
	if [ "${#TESTS[@]}" -le "$MIN_TESTS" ] || [ "$SHARDS" -le 1 ]; then
		add_job "$pkg" "" ""
		continue
	fi
	# Round robin. Duration per test is not known here, and the alternative
	# (a checked-in timing table) goes stale silently; with this many tests per
	# shard the averages even out.
	for ((s = 0; s < SHARDS; s++)); do
		names=""
		for ((i = s; i < ${#TESTS[@]}; i += SHARDS)); do
			names="$names|${TESTS[$i]}"
		done
		[ -n "$names" ] || continue
		# Anchored and alternated so -run matches these tests and nothing else.
		# A bare list would also match any test whose name merely contains one.
		add_job "$pkg" "s$s" "^(${names#|})$"
	done
	echo "go-test-sharded: $pkg -> $SHARDS shards of ~$((${#TESTS[@]} / SHARDS)) tests"
done

find "$WORK/jobs" -type f -print0 | sort -z |
	xargs -0 -P "$JOBS" -I{} "${BASH_SOURCE[0]}" --run-job {}

FAILED=0
for st in "$WORK"/status/*; do
	[ -e "$st" ] || continue
	code="$(cat "$st")"
	if [ "$code" != "0" ]; then
		FAILED=1
		cat "$WORK/log/$(basename "$st")"
	fi
done

# A job that never wrote a status file was killed outright (OOM, a signal). Count
# it as a failure: treating a missing result as a pass is how a green run stops
# meaning anything.
if [ "$(find "$WORK/jobs" -type f | wc -l)" != "$(find "$WORK/status" -type f | wc -l)" ]; then
	echo "go-test-sharded: FAILED - a shard produced no result (killed?)" >&2
	FAILED=1
fi

# Per-shard wall clock, always. A sharded run is only as fast as its slowest
# shard, so a lopsided split is the thing to look at when the speedup disappoints
# and it is invisible from the total alone.
for job in "$WORK"/jobs/*; do
	[ -e "$job" ] || continue
	id="$(basename "$job")"
	# The job file stores %q-quoted values so it can be sourced; re-sourcing just
	# the label is how it gets read back unmangled.
	label="$( (unset JOB_LABEL; . "$job"; printf '%s' "$JOB_LABEL") )"
	secs="$(cat "$WORK/secs/$id" 2>/dev/null || echo '?')"
	printf 'go-test-sharded: %5ss  %s\n' "$secs" "$label"
done

if [ "$FAILED" != "0" ]; then
	echo "go-test-sharded: FAILED" >&2
	exit 1
fi

if [ -n "$COVERPROFILE" ]; then
	# An empty cov dir would leave the glob unexpanded and hand awk a path that
	# does not exist, so a run that legitimately measured nothing would look like
	# a broken one.
	if [ -z "$(find "$WORK/cov" -type f -print -quit)" ]; then
		echo "go-test-sharded: no coverage produced" >&2
		: >"$COVERPROFILE"
		exit 0
	fi
	# Sum per block across shards. Every shard covers the same block set (same
	# package, same build) and only the counts differ, so summing reconstructs
	# what one sequential run would have produced. Key on the block position
	# alone: the statement count is a property of the block, not of the run.
	awk '
		FNR == 1 && $0 ~ /^mode:/ { mode = $0; next }
		{
			if (!($1 in stmts)) { stmts[$1] = $2; order[++n] = $1 }
			count[$1] += $3
		}
		END {
			if (mode == "") exit 0
			print mode
			for (i = 1; i <= n; i++) print order[i], stmts[order[i]], count[order[i]]
		}
	' "$WORK"/cov/* >"$COVERPROFILE"
fi

for pkg in "${RESOLVED[@]}"; do
	echo "ok  	$pkg"
done
