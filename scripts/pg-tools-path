#!/usr/bin/env bash
# pg-tools-path - print a directory to put FIRST on PATH before running the Go
# tests, so pg_dump/pg_restore match the test Postgres server.
#
# The backup tests dump and restore against the test server, and the client
# major has to equal the server's: pg_dump refuses a server newer than itself,
# and a newer pg_restore emits settings the older server rejects (18 into 16
# fails on SET transaction_timeout). CI, the app image and compose all pin the
# same major, so this only matters on a dev machine whose client moved ahead.
#
# When the host client major differs from the server image's and docker is
# available, the directory holds shims that run the tools from the same image
# the test server uses: host network reaches localhost:5433, /tmp (and TMPDIR)
# are mounted so dump paths resolve, PGPASSWORD passes through, and the caller's
# uid owns what pg_dump writes so t.TempDir can clean up. Otherwise the directory
# is empty and PATH is unchanged in effect.
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
# Under the repo's own gitignored bin/, never a shared temp dir: this directory
# goes first on PATH, so it must be one no other local user can pre-create.
DIR="$REPO_ROOT/bin/pg-tools"
mkdir -p "$DIR"
chmod 700 "$DIR"

image="$(grep -m1 -oE 'image:[[:space:]]*postgres:[^[:space:]]+' "$REPO_ROOT/docker-compose.test.yml" | sed 's/image:[[:space:]]*//' || true)"
if [ -z "$image" ]; then
	# Fail closed, but say so: under set -e a silent grep miss surfaced as the
	# test targets' "printed no directory" with nothing to go on.
	echo "pg-tools-path: no literal postgres image tag in docker-compose.test.yml; cannot match the client major" >&2
	exit 1
fi
server_major="$(printf '%s' "$image" | sed -E 's/^postgres:([0-9]+).*/\1/')"
# The host client is read with this directory taken off PATH: a call made while
# an earlier call's shim is already first on PATH would otherwise read the
# shim's version, take the host for a match and delete the shims under a test
# run that is still using them.
host_path=":${PATH:-}:"
# Quoted so a directory with glob characters in its name still matches literally.
while [ "$host_path" != "${host_path//":$DIR:"/:}" ]; do host_path="${host_path//":$DIR:"/:}"; done
host_path="${host_path#:}"
host_path="${host_path%:}"
host_major="$( (PATH="$host_path" pg_restore --version 2>/dev/null || true) | sed -nE 's/.*\) ([0-9]+)\..*/\1/p')"

if [ -n "$server_major" ] && [ "$host_major" != "$server_major" ] && command -v docker >/dev/null 2>&1; then
	# Mount arguments and the image reference are shell-quoted into the shim,
	# so a TMPDIR with spaces stays one argument and the shim's contract holds
	# for whatever the compose file names.
	mounts="-v /tmp:/tmp"
	if [ -n "${TMPDIR:-}" ] && [ "$TMPDIR" != "/tmp" ]; then
		mounts="$mounts -v $(printf '%q' "$TMPDIR:$TMPDIR")"
	fi
	# Written beside and renamed over: a run already using the directory keeps
	# seeing a whole shim, never a missing or half-written one.
	for tool in pg_dump pg_restore; do
		tmp="$DIR/.$tool.$$"
		cat >"$tmp" <<SHIM
#!/bin/sh
exec docker run --rm --network host --user "\$(id -u):\$(id -g)" $mounts -e PGPASSWORD -e TMPDIR $(printf '%q' "$image") $tool "\$@"
SHIM
		chmod +x "$tmp"
		mv -f "$tmp" "$DIR/$tool"
	done
	echo "pg-tools-path: host pg client is ${host_major:-absent}, test server is $server_major; using $image tools via docker" >&2
else
	# No shim wanted on this machine; a stale one from an earlier client would
	# shadow the matching host tools.
	rm -f "$DIR"/pg_dump "$DIR"/pg_restore
fi
printf '%s\n' "$DIR"
