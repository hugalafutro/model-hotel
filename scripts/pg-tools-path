#!/usr/bin/env bash
# pg-tools-path - print a directory to put FIRST on PATH before running the Go
# tests, so pg_dump/pg_restore match the test Postgres server.
#
# The backup tests dump and restore against the test server, and the client
# major has to equal the server's: pg_dump refuses a server newer than itself,
# and a newer pg_restore emits settings the older server rejects (18 into 16
# fails on SET transaction_timeout). CI, the app image and compose all pin the
# same major, so this only matters on a dev machine whose client moved ahead.
#
# When the host client major differs from the server image's and docker is
# available, the directory holds shims that run the tools from the same image
# the test server uses: host network reaches localhost:5433, /tmp (and TMPDIR)
# are mounted so dump paths resolve, PGPASSWORD passes through, and the caller's
# uid owns what pg_dump writes so t.TempDir can clean up. Otherwise the directory
# is empty and PATH is unchanged in effect.
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
DIR="${TMPDIR:-/tmp}/model-hotel-pg-tools-$(id -u)"
mkdir -p "$DIR"
rm -f "$DIR"/pg_dump "$DIR"/pg_restore

image="$(grep -m1 -oE 'image:[[:space:]]*postgres:[^[:space:]]+' "$REPO_ROOT/docker-compose.test.yml" | sed 's/image:[[:space:]]*//')"
server_major="$(printf '%s' "$image" | sed -E 's/^postgres:([0-9]+).*/\1/')"
host_major="$( (pg_restore --version 2>/dev/null || true) | sed -nE 's/.*\) ([0-9]+)\..*/\1/p')"

if [ -n "$server_major" ] && [ "$host_major" != "$server_major" ] && command -v docker >/dev/null 2>&1; then
	mounts="-v /tmp:/tmp"
	if [ -n "${TMPDIR:-}" ] && [ "$TMPDIR" != "/tmp" ]; then
		mounts="$mounts -v $TMPDIR:$TMPDIR"
	fi
	for tool in pg_dump pg_restore; do
		cat >"$DIR/$tool" <<SHIM
#!/bin/sh
exec docker run --rm --network host --user "\$(id -u):\$(id -g)" $mounts -e PGPASSWORD -e TMPDIR $image $tool "\$@"
SHIM
		chmod +x "$DIR/$tool"
	done
	echo "pg-tools-path: host pg client is ${host_major:-absent}, test server is $server_major; using $image tools via docker" >&2
fi
printf '%s\n' "$DIR"
